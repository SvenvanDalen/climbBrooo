<?xml version="1.0" encoding="UTF-8"?>
<!--
    Connect IQ app settings: exposes darkTheme and largeTextMode (from properties.xml)
    as on/off toggles in Garmin Connect Mobile / Garmin Express ("Low-light dark theme",
    "Large text mode"), and climbAlertDistinctTone as the opt-in alternative
    climb-start alert (issue #83).
-->
<settings>
    <setting propertyKey="@Properties.darkTheme" title="@Strings.SettingsDarkThemeTitle">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.largeTextMode" title="@Strings.SettingsLargeTextModeTitle">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.climbAlertDistinctTone" title="@Strings.SettingsClimbAlertDistinctToneTitle">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.colorMode" title="@Strings.SettingsColorModeTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.ColorModeGradient</listEntry>
            <listEntry value="1">@Strings.ColorModeFtpZone</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.lightsReminder" title="@Strings.SettingsLightsReminderTitle">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.lightsLeadMin" title="@Strings.SettingsLightsLeadTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.LightsLeadSunset</listEntry>
            <listEntry value="15">@Strings.LightsLead15</listEntry>
            <listEntry value="30">@Strings.LightsLead30</listEntry>
            <listEntry value="60">@Strings.LightsLead60</listEntry>
        </settingConfig>
    </setting>
</settings>
