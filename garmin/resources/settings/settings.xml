<?xml version="1.0" encoding="UTF-8"?>
<!--
    Connect IQ app settings: exposes darkTheme (from properties.xml) as a single
    on/off toggle in Garmin Connect Mobile / Garmin Express ("Low-light dark theme").
-->
<settings>
    <setting propertyKey="@Properties.darkTheme" title="@Strings.SettingsDarkThemeTitle">
        <settingConfig type="boolean"/>
    </setting>
</settings>
