<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_bg"
            android:titleTextColor="@color/color_text_primary"
            android:title="@string/settings_title"
            app:popupTheme="@style/ThemeOverlay.Material3.Dark"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_bg"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- App language (issue #261). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextAppearance.ClimbPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language_label"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/btn_language"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Taal: Systeemtaal"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextAppearance.ClimbPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_watch_mode"
                    android:layout_marginBottom="10dp"/>

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radio_route"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/color_accent"
                        android:textColor="@color/color_text_primary"
                        android:text="@string/settings_mode_route"/>

                    <RadioButton
                        android:id="@+id/radio_radius"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/color_accent"
                        android:textColor="@color/color_text_primary"
                        android:text="@string/settings_mode_radius"/>

                </RadioGroup>

                <LinearLayout
                    android:id="@+id/radius_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/radius_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 km"
                        android:textColor="@color/color_accent"
                        android:textStyle="bold"
                        android:fontFamily="@font/space_grotesk"
                        android:layout_marginBottom="4dp"/>

                    <SeekBar
                        android:id="@+id/radius_seek_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:progressTint="@color/color_accent"
                        android:thumbTint="@color/color_accent"
                        android:max="100"
                        android:progress="30"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btn_watch_field_layout"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Horloge-velden"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextAppearance.ClimbPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_strava"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/btn_strava_auth"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_strava_sign_in"/>

                <Button
                    android:id="@+id/btn_strava_title_template"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_title_template"/>

                <Button
                    android:id="@+id/btn_strava_history_backfill"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_history_backfill"/>

                <TextView
                    android:id="@+id/strava_history_backfill_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- intervals.icu (issue #78): planned workouts on the intervals.icu calendar. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextAppearance.ClimbPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intervals_title"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/btn_intervals_icu"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/intervals_settings_button"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextAppearance.ClimbPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_rider_profile"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/input_ftp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:fontFamily="@font/space_grotesk"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_tertiary"
                    android:hint="@string/settings_ftp_hint"
                    android:inputType="number"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/suggested_ftp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_accent"
                    android:textStyle="bold"
                    android:fontFamily="@font/space_grotesk"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"
                    tools:text="Voorgestelde FTP: 245 W (toepassen?)"/>

                <EditText
                    android:id="@+id/input_rider_weight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:fontFamily="@font/space_grotesk"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_tertiary"
                    android:hint="@string/settings_rider_weight_hint"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/input_bike_weight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:fontFamily="@font/space_grotesk"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_tertiary"
                    android:hint="@string/settings_bike_weight_hint"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/input_ride_intensity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:fontFamily="@font/space_grotesk"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_tertiary"
                    android:hint="@string/settings_ride_intensity_hint"
                    android:inputType="number"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btn_save_profile"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_save_profile"/>
            </LinearLayout>

            <!-- Virtual ghost for climbs without history (issue #31). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextAppearance.ClimbPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_ghost_title"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:textColor="@color/color_text_secondary"
                    android:text="@string/settings_ghost_explanation"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/input_ghost_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:fontFamily="@font/space_grotesk"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_tertiary"
                    android:hint="@string/settings_ghost_speed_hint"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/input_ghost_vam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:fontFamily="@font/space_grotesk"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_tertiary"
                    android:hint="@string/settings_ghost_vam_hint"
                    android:inputType="number"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btn_save_ghost"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_ghost_save"/>
            </LinearLayout>

            <!-- Home-climb privacy zone (issue #92). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextAppearance.ClimbPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_privacy"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/settings_privacy_explanation"/>

                <TextView
                    android:id="@+id/privacy_radius_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500 m"
                    android:textColor="@color/color_accent"
                    android:textStyle="bold"
                    android:fontFamily="@font/space_grotesk"
                    android:layout_marginBottom="4dp"/>

                <SeekBar
                    android:id="@+id/privacy_radius_seek_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/color_accent"
                    android:thumbTint="@color/color_accent"
                    android:max="1900"
                    android:progress="400"/>

            </LinearLayout>

            <!-- Colorblind-friendly palette (issue #258). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextAppearance.ClimbPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kleuren"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_secondary"
                    android:layout_marginBottom="10dp"
                    android:text="Hellingkleuren van lichtgeel via lichtblauw naar donkerblauw in plaats van geel naar rood, en statuskleuren blauw/oranje in plaats van groen/rood. Beter te onderscheiden bij kleurenblindheid; geldt voor de app en, na de volgende sync, voor het horloge."/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_colorblind_palette"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:text="Kleurenblind-vriendelijk palet"/>
            </LinearLayout>

            <!-- Display units (issue #262). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextAppearance.ClimbPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eenheden"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_secondary"
                    android:layout_marginBottom="10dp"
                    android:text="Alleen de weergave verandert; alles wordt metrisch opgeslagen. Het horloge neemt de afstandseenheid over bij de volgende sync."/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_units_imperial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:text="Mijlen en voet (mi · ft · mph)"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_units_psi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:text="Bandenspanning in psi"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_units_fahrenheit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:text="Temperatuur in °F"/>
            </LinearLayout>

            <!-- Cleaning reminder after wet rides (issue #234). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextAppearance.ClimbPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_wet_title"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_secondary"
                    android:layout_marginBottom="10dp"
                    android:text="@string/settings_wet_explanation"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_wet_ride_reminder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:text="@string/settings_wet_switch"/>
            </LinearLayout>

            <!-- Health Connect (issue #255). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextAppearance.ClimbPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_health_connect"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/health_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_secondary"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/btn_health_connect"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/settings_health_connect"/>

                <Button
                    android:id="@+id/btn_health_export"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/settings_health_export"/>

                <Button
                    android:id="@+id/btn_health_weight"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/settings_health_weight"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_health_auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:text="@string/settings_health_auto"/>
            </LinearLayout>

            <!-- Back-up (issue #257): manual zip + daily automatic copy to a picked folder. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextAppearance.ClimbPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backup"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/backup_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_secondary"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/btn_backup_create"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/settings_backup_create"/>

                <Button
                    android:id="@+id/btn_backup_restore"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/settings_backup_restore"/>

                <Button
                    android:id="@+id/btn_backup_auto"
                    style="@style/Widget.ClimbPro.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backup_auto_on"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_sync_now"
                style="@style/Widget.ClimbPro.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_sync_now"/>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
