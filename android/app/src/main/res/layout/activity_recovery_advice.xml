<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_bg"
        android:title="Herstel"
        app:titleTextColor="@color/color_text_primary"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Neutral, non-alarming by default: plain text, no icons or colour until we
                 know there is actually something to say. -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="" />

            <TextView
                android:id="@+id/rationaleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/color_text_secondary"
                android:textSize="15sp"
                android:text="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:background="@color/color_surface"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LAATSTE 7 DAGEN"
                    android:textColor="@color/color_text_primary"
                    android:alpha="0.85"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/recentGainText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/color_text_primary"
                    android:textSize="22sp"
                    android:text="" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="GEMIDDELD PER WEEK (LAATSTE 4 WEKEN)"
                    android:textColor="@color/color_text_primary"
                    android:alpha="0.85"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/baselineText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/color_text_primary"
                    android:textSize="22sp"
                    android:text="" />

            </LinearLayout>

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:textColor="@color/color_text_primary"
                android:textSize="16sp"
                android:visibility="gone"
                android:text="Nog niet genoeg gegevens om je belasting te beoordelen." />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
