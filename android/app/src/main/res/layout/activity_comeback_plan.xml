<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:title="Terugkomstplan" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/check_injury"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ik kom terug van een blessure (voorzichtiger opbouw)" />

            <Button
                android:id="@+id/btn_start"
                style="@style/Widget.ClimbPro.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Plan starten" />

            <TextView
                android:id="@+id/baseline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:textColor="@color/color_text_tertiary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/weeks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:textColor="@color/color_text_tertiary"
                android:textSize="12sp"
                android:text="Gereden ritten komen uit je rittenarchief (Strava-sync). Voel je pijn of ben je erg moe, doe dan een week rustiger. Bij blessures gaat het advies van je arts of fysiotherapeut voor." />

            <Button
                android:id="@+id/btn_stop"
                style="@style/Widget.ClimbPro.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:text="Plan stoppen" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
