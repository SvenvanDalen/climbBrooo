<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:title="Hoogtemeter-doel" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Geef op hoeveel hoogtemeters je vandaag wilt rijden. De app kiest een combinatie van bekende klimmen in de buurt die dat doel benadert." />

            <EditText
                android:id="@+id/targetInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Doel hoogtemeters (bijv. 1500)"
                android:inputType="number"
                android:maxLength="5" />

            <EditText
                android:id="@+id/radiusInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Maximale straal rond start (km)"
                android:inputType="number"
                android:maxLength="3" />

            <EditText
                android:id="@+id/maxClimbsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Maximaal aantal klimmen (optioneel)"
                android:inputType="number"
                android:maxLength="2" />

            <TextView
                android:id="@+id/startLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Startpunt: nog niet gekozen"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/useLocationButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Huidige locatie" />

                <Button
                    android:id="@+id/pickRouteStartButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Start van route" />
            </LinearLayout>

            <Button
                android:id="@+id/suggestButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Stel combinatie voor" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/resultList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/disclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textStyle="italic"
                android:visibility="gone"
                android:text="Afstanden zijn hemelsbreed, geen gerouteerde afstand — de echte rit is langer. Plan de werkelijke route over de weg zelf in Garmin Connect, Strava of Komoot." />

            <Button
                android:id="@+id/addToPlanningButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:text="Toevoegen aan klimplanning" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
