<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Versnellingen" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/input_chainrings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Kettingbladen (bv. 50/34)"
                android:importantForAutofill="no"
                android:inputType="text" />

            <AutoCompleteTextView
                android:id="@+id/input_cassette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="0"
                android:hint="Cassette (bv. 11-34, of 11,12,13,…)"
                android:importantForAutofill="no"
                android:inputType="text" />

            <EditText
                android:id="@+id/input_wheel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Wielomtrek in mm (700x25c = 2105, 700x28c = 2136)"
                android:importantForAutofill="no"
                android:inputType="number" />

            <EditText
                android:id="@+id/input_cadence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Gewenste cadans (rpm)"
                android:importantForAutofill="no"
                android:inputType="number" />

            <Button
                android:id="@+id/btn_calculate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bereken" />

            <TextView
                android:id="@+id/gear_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/gear_verdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gear_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
