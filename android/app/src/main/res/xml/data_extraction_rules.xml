<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (Google Drive) and device-to-device transfer, Android 12+ (issue
     #257). Keep in step with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="strava_auth.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude domain="file" path="sync_state.json" />
        <exclude domain="file" path=".restore_staging" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="strava_auth.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude domain="file" path="sync_state.json" />
        <exclude domain="file" path=".restore_staging" />
    </device-transfer>
</data-extraction-rules>
