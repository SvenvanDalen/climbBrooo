<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes cacheDir/shared_routes/ so the Garmin Connect handoff GPX is shareable,
     and getExternalFilesDir(DIRECTORY_DOWNLOADS)/ so the update-checker's downloaded
     APK is installable via the package installer. -->
<paths>
    <cache-path name="shared_routes" path="shared_routes/"/>
    <external-files-path name="downloads" path="Download/"/>
</paths>
