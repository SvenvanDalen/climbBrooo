<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional: only requested/used when the user opts in to also add a planned climb to
         their device calendar (issue #70). The in-app reminder never depends on this. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- In-app update checker: install a downloaded release APK from outside the Play Store. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Health Connect (issue #255): write rides, read the latest weight. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_ELEVATION_GAINED" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!-- Required on Android 11+ (targetSdk 30+) so the CIQ SDK can bind to
         the Garmin Connect Mobile service. Without this, initialize() reports
         GCM_NOT_INSTALLED even when Garmin Connect is installed. -->
    <queries>
        <package android:name="com.garmin.android.apps.connectmobile" />
        <!-- Text-to-speech engine for the spoken voice-shortcut answers (issue #260). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Find the Wahoo / Hammerhead companion apps among GPX share targets (issue #254). -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/gpx+xml" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/octet-stream" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- Health Connect app (Android 13 and lower). -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".ClimbProApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClimbPro">

        <activity
            android:name=".ui.routes.RouteListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Voice-assistant / launcher shortcuts (issue #260). Exported so Google Assistant
             can open it via OPEN_APP_FEATURE; it only reads/activates the user's own route.
             configChanges: recreation would run the command (e.g. start ride + sync) twice. -->
        <activity
            android:name=".ui.voice.VoiceShortcutActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ClimbPro.Translucent">
            <intent-filter>
                <action android:name="nl.paree.climbpro.action.START_RIDE" />
                <action android:name="nl.paree.climbpro.action.NEXT_CLIMB" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.routes.RouteDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity"/>

        <activity
            android:name=".ui.climbs.ClimbDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteDetailActivity"/>

        <activity
            android:name=".ui.climbs.ClimbBulkRenameActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteDetailActivity"/>

        <activity
            android:name=".ui.climbs.ClimbHygieneActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity"/>

        <activity
            android:name=".ui.climbs.ClimbLogbookActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.planning.PlannedClimbListActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.planning.MultiDayTourActivity"
            android:exported="false"
            android:parentActivityName=".ui.planning.PlannedClimbListActivity" />

        <activity
            android:name=".ui.planning.ElevationTargetActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.climbs.ClimbTimelineActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.climbs.RideFatigueActivity"
            android:exported="false"
            android:parentActivityName=".ui.climbs.ClimbTimelineActivity" />

        <activity
            android:name=".ui.climbs.UnfinishedClimbsActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.rides.RideArchiveActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.records.RideRecordsActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <!-- Friends' feed (issue #240). Exported only for text shares, so a friend's chat
             message with a CPF1: code can be sent straight to ClimbPro; the decoder treats
             the text as untrusted. -->
        <activity
            android:name=".ui.social.FriendFeedActivity"
            android:exported="true"
            android:label="Vriendenfeed"
            android:parentActivityName=".ui.routes.RouteListActivity">
            <intent-filter android:label="Vriendenfeed (ClimbPro)">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.tire.TirePressureLogActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.wrapped.ClimbWrappedActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.regions.VisitedRegionsActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.recovery.RecoveryAdviceActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.fit.SaddleHeightActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.collections.CollectionListActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.goals.ElevationGoalActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.collections.CollectionDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.collections.CollectionListActivity" />

        <!-- Health Connect permission rationale (issue #255): Android 13 and lower use the
             intent filter, Android 14+ the activity-alias below. -->
        <activity
            android:name=".ui.health.HealthConnectRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".ui.health.HealthConnectRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.privacy.PrivacyDashboardActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.quiz.PhotoQuizActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <!-- Garmin Connect ride import (issue #253): share or open a FIT / GPX / export zip. -->
        <!-- configChanges: a recreated translucent instance would sit invisibly over the app. -->
        <activity
            android:name=".ui.activity.ActivityImportActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Rit importeren in ClimbPro"
            android:theme="@style/Theme.ClimbPro.Translucent">
            <intent-filter android:label="Rit importeren in ClimbPro">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.ant.fit" />
                <data android:mimeType="application/fit" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="Rit importeren in ClimbPro">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.ant.fit" />
                <data android:mimeType="application/fit" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.maintenance.MaintenanceActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity"/>

        <activity
            android:name=".ui.settings.StravaTitleTemplateActivity"
            android:exported="false"
            android:parentActivityName=".ui.settings.SettingsActivity"/>

        <activity
            android:name=".ui.strava.StravaAuthActivity"
            android:exported="false"
            android:parentActivityName=".ui.routes.RouteListActivity"/>

        <activity
            android:name=".ui.strava.StravaAuthCallbackActivity"
            android:exported="false"/>

        <!-- AppAuth's own manifest declares RedirectUriReceiverActivity with
             scheme="${appAuthRedirectScheme}" (set to "climbpro" in build.gradle).
             We override it here to add host+path specificity for the callback URI. -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true"
            tools:node="replace"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="climbpro"
                    android:host="oauth"
                    android:path="/callback"/>
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.work.impl.WorkManagerInitializer"
            android:authorities="${applicationId}.workmanager-init"
            android:exported="false"
            tools:node="remove"
            xmlns:tools="http://schemas.android.com/tools"/>

        <!-- Shares the route GPX to Garmin Connect (navigation-handoff). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- Refresh CIQ binder-service registration immediately after reboot. -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget: week totals + next planned climb (issue #259). -->
        <receiver
            android:name=".widget.WeekWidgetProvider"
            android:exported="false"
            android:label="@string/widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>

        <!-- Launches the install prompt once the update-checker's APK download finishes. -->
        <receiver
            android:name=".update.DownloadCompleteReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
